{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "logstrip hook",
        "matcher": "Read",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "logstrip hook",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ]
  }
}
